# Copy to .env.local for local development. Never commit real values.
# Production and staging values are set in Vercel and Supabase, not in files.

# --- App ---
# Public base URL of the app. Used in emails and Stripe redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign booking-management links sent to customers (min 32 chars).
BOOKING_LINK_SECRET=

# --- Supabase ---
# Public project URL and anon key. Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (test mode in local and staging) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="Salon Name <bookings@example.com>"

# --- SMS (Twilio) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Monitoring (Sentry) ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Business settings ---
# IANA time zone for the salon. Do not change without reading ARCHITECTURE.md section 1.
SALON_TIME_ZONE=Europe/London
